					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Server</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">08285c0aafb9c5f3020cf3450001ae3d</UniqueId>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX7BF3887986A149819A537402CD627B36">
				<Properties>
					<ProtectedString name="Source"><![CDATA[while wait() do
	if game:IsLoaded()==true then
		break
	end
end

local Tool=script.Parent
local Player=game.Players.LocalPlayer
local Mouse=Player:GetMouse()

local reloading="rbxasset://textures\\GunWaitCursor.png"
local ready="rbxasset://textures\\GunCursor.png"

local currentIcon=ready

Tool.Equipped:connect(function()
	Mouse.Icon=currentIcon
end)
Tool.Unequipped:connect(function()
	Mouse.Icon=""
end)

local function Test(var,bool1,bool2)
	if var==bool1 then
		currentIcon=ready
	elseif var==bool2 then
		currentIcon=reloading
	end
end

Tool:GetPropertyChangedSignal("Enabled"):connect(function() -- no need to worry abt security, just a mouse icon change
	Test(Tool.Enabled,true,false)
	local c=Player.Character
	if not c then return end
	local t=c:FindFirstChildWhichIsA("Tool") 
	if not t then return end
	if t~=Tool then return end -- ensure this is the tool being held
	Mouse.Icon=currentIcon
end)

Tool.Activated:connect(function()
	Tool.Fire:FireServer(Mouse.Hit.p)
end)
]]></ProtectedString>
