			</Properties>
			<Item class="LocalScript" referent="RBX684ECB2989174964AFFAAC839A1B2E8B">
				<Properties>
					<ProtectedString name="Source"><![CDATA[while wait() do
	if game:IsLoaded()==true then
		break
	end
end

local ChangeAmount = 5 
local Camera = workspace.CurrentCamera 
local ModFx=require(game.ReplicatedStorage.Other)
local me=game.Players.LocalPlayer

game:GetService("UserInputService").InputBegan:connect(function(Input,GPE)
	if not GPE then
		if Input.UserInputType == Enum.UserInputType.Keyboard then
			workspace.CurrentCamera.CameraType = "Custom"
			if Input.KeyCode==Enum.KeyCode.Semicolon then
				Camera.FieldOfView=Camera.FieldOfView-ChangeAmount
			elseif Input.KeyCode==Enum.KeyCode.Quote then
				Camera.FieldOfView=Camera.FieldOfView+ChangeAmount
			elseif Input.KeyCode==Enum.KeyCode.M then
				Camera.FieldOfView=70
			end
		end
	end
end)

local Debris=game:GetService("Debris")
local ColSer=game:GetService("CollectionService")

workspace.ChildAdded:connect(function(Obj) -- "very taxing", i say, as I use yet another workspace listener function...
	-- i didnt want any 'return's in the last listener interfering with this listener
	if Obj.Name=="Rocket" then
		local tag1=ColSer:HasTag(Obj,Obj.Name)
		local tag2=ColSer:HasTag(Obj,me.Name)
		--PhysSer:CollisionGroupSetCollidable("Rockets", "Rockets", false)
		
		if tag1 and tag2 then
			local Tool=ModFx.GetToolFromPlayer("RocketLauncher",me)
			if not Tool then Debris:AddItem(Obj,0) return end
			local x
			x=Obj.Touched:connect(function(Part) -- detect for touches only on the local player's client]]
				if not ColSer:HasTag(Part,me.Name) then
					if not Tool then Debris:AddItem(Obj,0) return end
					local RDE=Tool:FindFirstChild("RocketDestroyEvent")
					if not RDE then Debris:AddItem(Obj,0) return end
					if Part.Name~="Baseplate" then
						--Line 50 deletes all missiles when one missile explodes, so when it is removed, you can spam as missiles as you want.
						RDE:FireServer(Obj,Obj.Position) -- Explosion happens on the server
						--				Tool.YieldBeyondTouch:Fire() -- Delete the rocket just after disconnecting the function (wait = 4 lines down)
						x:Disconnect() -- No need for debounce if you got this!
					end
				end				
			end)
			Tool.YieldBeyondTouch.Event:wait()
			Debris:AddItem(Obj,0)
		end
	end
end)

workspace.DescendantAdded:connect(function(Obj) -- very taxing, so only use it once
	if _G.ShowTrails==false then
		wait() 
		if Obj:IsA("ParticleEmitter") then
			Debris:AddItem(Obj,0)
		elseif Obj:IsA("Trail") then 
			if Obj.Parent.Parent:IsA("Tool") then -- sword
				Obj.Enabled=false
				local p=Obj:GetPropertyChangedSignal("Enabled"):connect(function(prop) -- check if the enabled property changed
					Obj.Enabled=false
				end)
				local o
				o=Obj.AncestryChanged:connect(function() -- check if the sword changes directory
					p:Disconnect()
					o:Disconnect() -- if it does, these functions will run again, and stack on each other, so we need to disconnect these first
				end)
			else
				Debris:AddItem(Obj,0)
			end
		elseif Obj:IsA("Fire") then
			Debris:AddItem(Obj,0)
		elseif Obj:IsA("Explosion") then
			Obj.Visible=true
		elseif Obj:IsA("BasePart") then
			if Obj.Material==Enum.Material.Neon then
				Obj.Material=Enum.Material.Plastic
				if ColSer:HasTag(Obj,Obj.Name) then
					Obj.BrickColor=BrickColor.new(23) -- rocket
				else
					Obj.BrickColor=BrickColor.Random() -- the superball is colored differently when a trail is applied, so this makes it right 
				end
			end
		end
		return
	end
end)

local Mouse=me:GetMouse()
local c=me.Character
me.CharacterAdded:connect(function(char)
	c=char
	Mouse.Icon="" -- if you respawn while reloading, the icon remains. so this gets around that
end)]]></ProtectedString>
