				<Item class="LocalScript" referent="RBXB9ED4D9798D747E0B1C1AD056BB1F906">
					<Properties>
						<ProtectedString name="Source"><![CDATA[while wait() do
	if game:IsLoaded()==true then
		break
	end
end

local wfc=1 -- all the waitforchilds probably arent necessary because of the first 5 lines but i dont feel like changing it

_G.ShowTrails=true
_G.ShowTrajectory=true

local Frame=script.Parent
local GUI=Frame.Parent
local Effects=Frame:WaitForChild("Effects",wfc)
local TrailButton=Effects:WaitForChild("TrailToggle",wfc)
local TrajectoryButton=Effects:WaitForChild("TrajectoryToggle",wfc)
local Spectator=Frame:WaitForChild("Spectator",wfc)
local SpectatorButton=Spectator:WaitForChild("SpectatorToggle",wfc)
local SpectatorNote=Spectator:WaitForChild("TextLabel",wfc)
local NextButton=Spectator:WaitForChild("Next",wfc)
local PrevButton=Spectator:WaitForChild("Previous",wfc)
local DefaultButton=Spectator:WaitForChild("Default",wfc)
local Time=Frame:WaitForChild("Time",wfc)
local CycleToggle=Time:WaitForChild("CycleToggle",wfc)
local TimeText=Time:WaitForChild("Time",wfc)
local DefaultTime=Time:WaitForChild("Default",wfc)
local FOV=Frame:WaitForChild("FieldOfView",wfc)
local FOVMinus=FOV:WaitForChild("Minus",wfc)
local FOVPlus=FOV:WaitForChild("Plus",wfc)
local DefaultFOV=FOV:WaitForChild("Default",wfc)
local AdminFolder=Frame:WaitForChild("Admin",wfc)
local AdminButton=AdminFolder:WaitForChild("AdminButton",wfc)
local MiscFolder=Frame:WaitForChild("Misc",wfc)
local ToolButton=MiscFolder:WaitForChild("ToolButton",wfc)

local Player=game.Players.LocalPlayer
local RSP=game:GetService("ReplicatedStorage")

function ChangeTransparency(Item,Value)
	Item.BackgroundTransparency=Value
	Item.TextTransparency=Value
end

TrailButton.Activated:connect(function()
	if TrailButton.Text=="X" then
		TrailButton.Text=""
		_G.ShowTrails=false
	elseif TrailButton.Text=="" then
		TrailButton.Text="X"
		_G.ShowTrails=true
	end
end)

TrajectoryButton.Activated:connect(function()
	if TrajectoryButton.Text=="X" then
		TrajectoryButton.Text=""
		_G.ShowTrajectory=false
	elseif TrajectoryButton.Text=="" then
		TrajectoryButton.Text="X"
		_G.ShowTrajectory=true
	end
end)

SpectatorButton.Activated:connect(function()
	if RSP.Remotes.FetchTeamColor:InvokeServer()==BrickColor.new(1001) then
		if SpectatorButton.Text=="X" then
			SpectatorButton.Text=""
			ChangeTransparency(NextButton,0.75)
			ChangeTransparency(PrevButton,0.75)
			ChangeTransparency(DefaultButton,0.75)
			RSP.Remotes.RequestSpectator:FireServer(Player.Character,"Remove")
			pcall(function() workspace.CurrentCamera.CameraSubject=Player.Character.Humanoid end)
		elseif SpectatorButton.Text=="" then
			SpectatorButton.Text="X"
			ChangeTransparency(NextButton,0)
			ChangeTransparency(PrevButton,0)
			ChangeTransparency(DefaultButton,0)
			RSP.Remotes.RequestSpectator:FireServer(Player.Character,"Insert")
		end
	end
end)

local p=game.Players:GetPlayers() -- players
local cp=1 -- currentplayer
local playerName=game.Players.LocalPlayer.Name

game.Players.PlayerAdded:connect(function()
	p=game.Players:GetPlayers()
end)

game.Players.PlayerRemoving:connect(function()
	p=game.Players:GetPlayers()
end)

RSP.Remotes.RequestSpectator.OnClientEvent:connect(function(msg, plr)
	wait(.5)
	if msg=="PlayerLoaded" then
		if playerName==plr.Name then
			workspace.CurrentCamera.CameraSubject=plr.Character.Humanoid
		end
	elseif msg=="GameReset" then
		local lplr=game.Players.LocalPlayer
		playerName=lplr.Name
		workspace.CurrentCamera.CameraSubject=lplr.Character.Humanoid
	end
end)

function getNextGuy()
	wait()
	if cp<#p then
		cp=cp+1
	else
		cp=1
	end
	local plr=p[cp]
	if plr then
		if plr.TeamColor~=BrickColor.new(1001) then
			workspace.CurrentCamera.CameraSubject=plr.Character.Humanoid
		else
			getNextGuy()
		end
	end
end

function getPrevGuy()
	wait()
	if cp>1 then
		cp=cp-1
	else
		cp=#p
	end
	local plr=p[cp]
	if plr then
		if plr.TeamColor~=BrickColor.new(1001) then
			workspace.CurrentCamera.CameraSubject=plr.Character.Humanoid
		else
			getPrevGuy()
		end
	end
end

NextButton.Activated:connect(function()
	if RSP.Remotes.FetchTeamColor:InvokeServer()==BrickColor.new(1001) then
		if SpectatorButton.Text=="X" then
			getNextGuy()
			playerName=workspace.CurrentCamera.CameraSubject.Parent.Name
		end
	end
end)

PrevButton.Activated:connect(function()
	if RSP.Remotes.FetchTeamColor:InvokeServer()==BrickColor.new(1001) then
		if SpectatorButton.Text=="X" then
			getPrevGuy()
			playerName=workspace.CurrentCamera.CameraSubject.Parent.Name
		end
	end
end)

DefaultButton.Activated:connect(function()
	if RSP.Remotes.FetchTeamColor:InvokeServer()==BrickColor.new(1001) then
		for i=1,#p do
			if p[i]==game.Players.LocalPlayer then
				cp=i
			end
		end
		workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character.Humanoid
		playerName=workspace.CurrentCamera.CameraSubject.Parent.Name
	end
end)

RSP.Remotes.ChangeTeam.OnClientEvent:connect(function(TeamColor)
	if TeamColor==BrickColor.new(1001) then
		ChangeTransparency(SpectatorButton,0)
		ChangeTransparency(SpectatorNote,0)
	else
		for i,v in pairs(Spectator:GetChildren()) do
			ChangeTransparency(v,0.75)
		end
		SpectatorButton.Text=""
		RSP.Remotes.RequestSpectator:FireServer(Player.Character,"Remove")
	end
end)

local oldAdminButtonTxt=AdminButton.Text

local IsVIPServer
spawn(function()
	IsVIPServer=RSP.Remotes.IsVIPServer:InvokeServer()
	if IsVIPServer==true then
		ChangeTransparency(AdminButton,0)
	end
end)

local txtDebounce=false

local function DisplayVIPErrMsg(str)
	if txtDebounce==false then 
		txtDebounce=true
		AdminButton.Text=str
		wait(3.5)
		AdminButton.Text=oldAdminButtonTxt
		txtDebounce=false
	end
end

AdminButton.Activated:connect(function()
	if IsVIPServer==true then
		local Admin=GUI:FindFirstChild("AdminFrame")
		if not Admin then return end
		Admin.Visible=true	
		Frame.Visible=false	
	else
		DisplayVIPErrMsg("Buy a VIP server to use this!")
	end
end)

ToolButton.Activated:connect(function()
	local ToolOrder=GUI:FindFirstChild("ToolOrderFrame")
	if not ToolOrder then return end
	ToolOrder.Visible=true
	Frame.Visible=false
end)

local TE=true
local TC=false

CycleToggle.Activated:connect(function()
	if TC==false then
		TC=true
		TE=false
		CycleToggle.Text="X"
		ChangeTransparency(TimeText,0.75)
		TimeText.ClearTextOnFocus=false
	elseif TC==true then
		TC=false
		TE=true
		CycleToggle.Text=""
		ChangeTransparency(TimeText,0)
		TimeText.ClearTextOnFocus=true
	end
end)

local ModFx=require(game:GetService("ReplicatedStorage").Other)

function Round(x)
	return (ModFx.Round(x*10))/10
end

TimeText.Text=tostring(Round(game.Lighting.ClockTime))
game.Lighting:GetPropertyChangedSignal("ClockTime"):connect(function()
	TimeText.Text=tostring(Round(game.Lighting.ClockTime))
end)

TimeText.FocusLost:connect(function()
	if TE==true then
		local TimeNum=tonumber(TimeText.Text)
		if TimeNum then
			game.Lighting.ClockTime=TimeNum
		end
	end
end)

DefaultTime.Activated:connect(function()
	game.Lighting.ClockTime=14
end)

FOVMinus.Activated:connect(function()
	workspace.CurrentCamera.FieldOfView=workspace.CurrentCamera.FieldOfView-5
end)

FOVPlus.Activated:connect(function()
	workspace.CurrentCamera.FieldOfView=workspace.CurrentCamera.FieldOfView+5
end)

DefaultFOV.Activated:connect(function()
	workspace.CurrentCamera.FieldOfView=70
end)

while wait() do
	if TC==true then
		game.Lighting.ClockTime=game.Lighting.ClockTime+0.002
	end
end
]]></ProtectedString>
