				<Item class="LocalScript" referent="RBXF9B061EC0D53408BBE3D3D54995E613A">
					<Properties>
						<ProtectedString name="Source"><![CDATA[while wait() do
	if game:IsLoaded()==true then
		break
	end
end

local wfc=3

local Frame=script.Parent
local GUI=Frame.Parent
local Settings=GUI:WaitForChild("SettingsFrame",wfc)

local Pages=Frame:WaitForChild("Pages",wfc)
local BackButton=Frame:WaitForChild("BackButton",wfc)
local ForwardButton=Frame:WaitForChild("ForwardButton",wfc)
local PageList=Pages:GetChildren()
local CurrentPage=1
local MaxPages=#PageList
local LastPage

function TurnPage()
	for i=1,MaxPages do
		if i==CurrentPage then
			Pages[i].Visible=true
		else
			Pages[i].Visible=false
		end
	end
end

ForwardButton.Activated:connect(function()
	LastPage=CurrentPage 
	CurrentPage=CurrentPage+1 
	TurnPage()
	if CurrentPage==MaxPages then
		ForwardButton.Visible=false
	end
end)

BackButton.Activated:connect(function()
	LastPage=CurrentPage 
	if CurrentPage==1 then
		Settings.Visible=true
		Frame.Visible=false
	else
		CurrentPage=CurrentPage-1 
		TurnPage()
	end
	if LastPage==MaxPages then
		ForwardButton.Visible=true
	end
end)

for i,v in pairs(Frame:GetDescendants()) do
	if v.Name=="Enter" then
		v.Activated:connect(function()
			local running=false
			if running==false then
				running=true
				local t=0.5
				local TextBox=v.Parent.Text
				local receivingPlayer=TextBox.Text
				local oldclr=TextBox.TextColor3
				local cmd=v.Text
				local cmdresult=game.ReplicatedStorage.Remotes.Admin:InvokeServer(cmd,receivingPlayer)
				if cmdresult=="Success" then
					t=0.5
					TextBox.TextColor3=Color3.new(0,1,0)
				else
					t=1.5
					TextBox.TextColor3=Color3.new(1,0,0)
				end
				TextBox.Text=cmdresult
				wait(t)
				TextBox.TextColor3=oldclr
				TextBox.Text="Type username here"
				running=false
			end
		end)
	end
end]]></ProtectedString>
