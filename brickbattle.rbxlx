		<Item class="Script" referent="RBXFB006D276FF04F0CB05C1A14AD8F5E20">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- datastore general --
local DS=game:GetService("DataStoreService")
local DS1=DS:GetDataStore("Effects")

-- tool order initialization --
local DataStore = DS:GetDataStore("Backpack")
local keyInfo = "BP_"

local defaultOrder={}
for i,v in ipairs(game.StarterPack:GetChildren()) do
	defaultOrder[i]=v.Name
end

local playerToolOrder={}

local function UpdateTools(plr)
	local backpack=plr:FindFirstChild("Backpack")
	if not backpack then return end
	local c=plr.Character
	if not c then return end
	local h=c:FindFirstChild("Humanoid")
	if not h then return end
	backpack:ClearAllChildren()
	for i,v in pairs(c:GetDescendants()) do
		if v:IsA("Tool") then
			v:Destroy()
		end
	end
	for i,v in ipairs(playerToolOrder[plr]) do -- ipairs orders it by index
		game.StarterPack[v]:Clone().Parent=backpack
	end
end
	
local function changeOrderDS(ds,plr)
	if ds then
		UpdateTools(plr)
	end
end

-- vip server initialization -- 
local IsVIPServer=false
local VIPBan=DS:GetDataStore(game.VIPServerId.."Ban")
local VIPMod=DS:GetDataStore(game.VIPServerId.."Mod")
local mods={}
if (game.VIPServerOwnerId~=0) or (game.VIPServerId~="") then
	IsVIPServer=true
end

-- player joined function --
local ins=table.insert
local del=table.remove
local Players={}
local PlayersService=game:GetService("Players")
PlayersService.PlayerAdded:connect(function(newPlayer)
	-- vip server stuff -- 
	ins(Players,newPlayer)
	_G.UpdatePlayerTable(Players)
	if IsVIPServer then
		
		local banned=false
		if VIPBan:GetAsync(newPlayer.UserId) then
			banned=VIPBan:GetAsync(newPlayer.UserId)
		else
			VIPBan:SetAsync(newPlayer.UserId,false)
		end
		if banned==true then
			newPlayer:Kick("Banned by VIP Server Admin")
		end
		
		local mod=false
		if game.VIPServerOwnerId==newPlayer.UserId then
			if not VIPMod:GetAsync(newPlayer.UserId) then
				VIPMod:SetAsync(newPlayer.UserId,true) --[[ in case the VIPServerOwnerId doesn't display correctly after the first time, 
															they still get mod powers. yes this does happen sometimes ]]
			end
			mod=true
			mods[newPlayer.Name]="Owner"
		else
			if VIPMod:GetAsync(newPlayer.UserId) then
				mod=VIPMod:GetAsync(newPlayer.UserId)
			else
				VIPMod:SetAsync(newPlayer.UserId,false)
			end
		end
		if mod==true and ((not mods[newPlayer.Name]) or (mods[newPlayer.Name]~="Owner")) then
			-- if it's a manual mod
			mods[newPlayer.Name]="Mod"
		end
		
		--[[ POSSIBLE Future VIP server owner UI elements: 
			-- Kick/Ban Players (Permanent banlist can load datastore from the VIPServerId string maybe?)
			-- Number of Teams (and, therefore, number of towers present) with max being 4
			-- EXPLODING SUPERBALLS? ball.Touched:connect(function() local e=Instance.new("Explosion") e.Position=ball.Position e.Parent=workspace end)
		]]
	end
	
--	local j=false
--	for i,v in pairs(game.Teams:GetTeams()) do
--		if v.AutoAssignable==true then
--			j=true
--		end
--	end
--	for i,v in pairs(workspace:GetDescendants()) do
--		if v:IsA("SpawnLocation") and v.Name~="Lobby" then
--			j=true
--		end
--	end
--	if j==false then
--		newPlayer.Team=game.Teams.Spectators 
--	end
	-- havent tested the above block of code so I am not ready to uncomment it
	
	-- values --
	for i,v in pairs(game.ReplicatedStorage.Values:GetChildren()) do
		v:Clone().Parent=newPlayer
	end
	
	-- effects --
	local E=newPlayer:FindFirstChild("Effect") 
	if E then
		if DS1:GetAsync(newPlayer.UserId) then
			E.Value=DS1:GetAsync(newPlayer.UserId)
		else
			E.Value="None"
		end
	end
	
	-- tool order --
	playerToolOrder[newPlayer]=defaultOrder
	
	local key = keyInfo..newPlayer.userId
	local sv = DataStore:GetAsync(key)

	if sv then 
		playerToolOrder[newPlayer]=sv
	end
	
	-- character --
	local character = newPlayer.Character or newPlayer.CharacterAdded:Wait() -- the first spawn character doesnt always fire the event below
	if character then
		changeOrderDS(sv,newPlayer)
	end
	newPlayer.CharacterAdded:connect(function(Character)
		-- tool order stuff -- 
		changeOrderDS(sv,newPlayer)
		-- spectator anti-tk force disable -- 
		game.ReplicatedStorage.Remotes.RequestSpectator:FireAllClients("PlayerLoaded", newPlayer) -- spectate refresh on die
		local ATK=newPlayer:FindFirstChild("AntiTeamKill")
		if ATK and ATK.Value==true then
			if newPlayer.TeamColor==BrickColor.new(1001) then -- people who are spectators who reset dont get to cheat the system
				ATK.Value=false
			end
		end
	end)
	
end)

PlayersService.PlayerRemoving:connect(function(player)
--	del(Players,player) -- doesnt work cause you gotta delete the INDEX. I just won't delete it, its no big deal.
	local id=player.UserId
	local effectVal=player.Effect.Value
	if playerToolOrder[player] then
		DataStore:SetAsync((keyInfo..player.userId), playerToolOrder[player])
	end
	if effectVal then
		DS1:SetAsync(id,effectVal)
	end
end)

function HasPermission(TargetPlayerName,ModList)
	-- You can only run this command if the TargetPlayer is not an admin
	local auth=true
	for i,v in pairs(ModList) do
		if TargetPlayerName==i then
			auth=false
		end
	end
	return auth
	--[[ Untested other option?
	if ModList[TargetPlayerName] then
		return false
	else
		return true
	end
	--]]
end

function HasHighPermission(InvokePlayer,ModList)
	-- You can only run this command if the InvokePlayer is the owner
	if ModList[InvokePlayer.Name]=="Owner" then
		return true
	else
		return false
	end
end

cmds={
	["Kick"]=function(InvokePlayer,TargetPlayerName,ModList)
		local Lower1Name=string.lower(InvokePlayer.Name)
		local Lower2Name=string.lower(TargetPlayerName)
		if Lower1Name~=Lower2Name then
			if HasPermission(TargetPlayerName,ModList)==true then
				local ExistingPlayer=PlayersService:FindFirstChild(TargetPlayerName)
				if ExistingPlayer then
					ExistingPlayer:Kick("Kicked by server admin")
					return "Success"
				else
					return "Player not in-game"
				end
			else
				return "Cannot kick a VIP admin"
			end
		else
			return "Cannot kick yourself"
		end
	end,
	["Ban"]=function(InvokePlayer,TargetPlayerName,ModList)
		local Lower1Name=string.lower(InvokePlayer.Name)
		local Lower2Name=string.lower(TargetPlayerName)
		if Lower1Name~=Lower2Name then
			if HasPermission(TargetPlayerName,ModList)==true then
				local PlrUserId=PlayersService:GetUserIdFromNameAsync(TargetPlayerName)
				if VIPBan:GetAsync(PlrUserId) then
					if VIPBan:GetAsync(PlrUserId)==false then
						VIPBan:SetAsync(PlrUserId,true)
						local ExistingPlayer=PlayersService:FindFirstChild(TargetPlayerName)
						if ExistingPlayer then
							ExistingPlayer:Kick("Banned by server admin")
						end
						return "Success"
					else
						return "Player is already banned"
					end
				else
					VIPBan:SetAsync(PlrUserId,true)
					return "Success"
				end
			else
				return "Cannot ban a VIP admin"
			end
		else
			return "Cannot ban yourself"
		end
	end,
	["Unban"]=function(InvokePlayer,TargetPlayerName,ModList)
		local Lower1Name=string.lower(InvokePlayer.Name)
		local Lower2Name=string.lower(TargetPlayerName)
		if Lower1Name~=Lower2Name then
			local PlrUserId=PlayersService:GetUserIdFromNameAsync(TargetPlayerName)
			if VIPBan:GetAsync(PlrUserId) then
				if VIPBan:GetAsync(PlrUserId)==true then
					VIPBan:SetAsync(PlrUserId,false)
					return "Success"
				else
					return "Player is already unbanned"
				end
			else
				return "Player is already unbanned"
			end
		else
			return "Cannot unban yourself"
		end
	end,
	["Mod"]=function(InvokePlayer,TargetPlayerName,ModList)
		local Lower1Name=string.lower(InvokePlayer.Name)
		local Lower2Name=string.lower(TargetPlayerName)
		if Lower1Name~=Lower2Name then
			if HasHighPermission(InvokePlayer,ModList)==true then
				local PlrUserId=PlayersService:GetUserIdFromNameAsync(TargetPlayerName)
				if VIPMod:GetAsync(PlrUserId) then
					if VIPMod:GetAsync(PlrUserId)==false then
						VIPMod:SetAsync(PlrUserId,true)
						mods[TargetPlayerName]="Mod" 
						return "Success"
					else
						return "Player is already modded"
					end
				else
					VIPMod:SetAsync(PlrUserId,true)
					mods[TargetPlayerName]="Mod" 
					return "Success"
				end
			else
				return "Only owners can mod/unmod"
			end
		else
			return "Cannot mod yourself"
		end
	end,
	["Unmod"]=function(InvokePlayer,TargetPlayerName,ModList)
		local Lower1Name=string.lower(InvokePlayer.Name)
		local Lower2Name=string.lower(TargetPlayerName)
		if Lower1Name~=Lower2Name then
			if HasHighPermission(InvokePlayer,ModList)==true then
				local PlrUserId=PlayersService:GetUserIdFromNameAsync(TargetPlayerName)
				if VIPMod:GetAsync(PlrUserId) then
					if VIPMod:GetAsync(PlrUserId)==true then
						VIPMod:SetAsync(PlrUserId,false)
						mods[TargetPlayerName]=nil -- Doesnt get rid of their index though? More research on this later.
						return "Success"
					else
						return "Player is already unmodded"
					end
				else
					return "Player is already unmodded"
				end
			else
				return "Only owners can mod/unmod"
			end
		else
			return "Cannot unmod yourself"
		end
	end,
	["God"]=function(InvokePlayer,TargetPlayerName,ModList)
		local ExistingPlayer=PlayersService:FindFirstChild(TargetPlayerName)
		if ExistingPlayer then
			local char=ExistingPlayer.Character
			if char then
				if not char:FindFirstChildWhichIsA("ForceField") then
					local ff=Instance.new("ForceField")
					ff.Visible=false
					ff.Parent=char
					return "Success"
				else
					return "Character already godded"
				end
			else
				return "Character does not exist"
			end
		else
			return "Player not in-game"
		end
	end,
	["Ungod"]=function(InvokePlayer,TargetPlayerName,ModList)
		local ExistingPlayer=PlayersService:FindFirstChild(TargetPlayerName)
		if ExistingPlayer then
			local char=ExistingPlayer.Character
			if char then
				if char:FindFirstChildWhichIsA("ForceField") then
					for i,v in pairs(char:GetChildren()) do
						if v:IsA("ForceField") then
							v:Destroy()
						end
					end
					return "Success"
				else
					return "Character already ungodded"
				end
			else
				return "Character does not exist"
			end
		else
			return "Player not in-game"
		end
	end
}

game.ReplicatedStorage.Remotes.Admin.OnServerInvoke=function(InvokePlayer,command,TargetPlayerName)
	if game.VIPServerId=="" then
		local msg="Do not use exploits"
		InvokePlayer:Kick(msg)
		return msg
	else
		if cmds[command] then
			if mods[InvokePlayer.Name] then
				if TargetPlayerName~=nil then
					if pcall(function() PlayersService:GetUserIdFromNameAsync(TargetPlayerName) end) then
						return cmds[command](InvokePlayer,TargetPlayerName,mods)
					else
						return "Player does not exist"
					end
				else
					return cmds[command]()
				end
			else
				return "Unauthorized"
			end
		else
			return "That is not a command"
		end
	end
end

game.ReplicatedStorage.Remotes.FetchTeamColor.OnServerInvoke = function(player)
	return player.TeamColor
end

game.ReplicatedStorage.Remotes.IsVIPServer.OnServerInvoke = function(player)
	return IsVIPServer
end

game.ReplicatedStorage.Remotes.RequestSpectator.OnServerEvent:connect(function(player,char,arg)
	if player.TeamColor==BrickColor.new(1001) then
		local x=player.Character:GetDescendants()
		for i=1,#x do 
			if x[i]:IsA("ForceField") then
				x[i]:Destroy()
			end
		end
		local ATK=player:FindFirstChild("AntiTeamKill")
		if arg=="Insert" then
			Instance.new("ForceField",char)
			if ATK then
				ATK.Value=true
			end
		elseif arg=="Remove" then
			if ATK then
				ATK.Value=false
			end
		end
	end
end)

local totalNumTools=#game.StarterPack:GetChildren()

local function IsWep(str)
	for i,v in pairs(defaultOrder) do
		if v==str then
			return v
		end
	end
	return nil
end

game.ReplicatedStorage.Remotes.Backpack.OnServerEvent:connect(function(plr,order)
	if #order~=totalNumTools then return end
	for i,v in ipairs(order) do
		if not IsWep(v) then return end
	end
	playerToolOrder[plr]=order
	UpdateTools(plr)
end)]]></ProtectedString>
