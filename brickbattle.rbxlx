				<Properties>
					<ProtectedString name="Source"><![CDATA[while wait() do
	if game:IsLoaded()==true then
		break
	end
end

local Tool=script.Parent
local Player=game.Players.LocalPlayer
local c=Player.Character
local Mouse=Player:GetMouse()

local currentIcon="rbxasset://textures\\GunCursor.png"

Tool.Equipped:connect(function()
	Mouse.Icon=currentIcon
end)
Tool.Unequipped:connect(function()
	Mouse.Icon=""
end)

local function Test(var,bool1,bool2)
	if var==bool1 then
		currentIcon="rbxasset://textures\\GunCursor.png"
	elseif var==bool2 then
		currentIcon="rbxasset://textures\\GunWaitCursor.png"
	end
end

Tool:GetPropertyChangedSignal("Enabled"):connect(function() -- no need to worry abt security, just a mouse icon change
	Test(Tool.Enabled,true,false)
	c=Player.Character
	if not c then return end
	local t=c:FindFirstChildWhichIsA("Tool") 
	if not t then return end
	if t~=Tool then return end -- ensure this is the tool being held
	Mouse.Icon=currentIcon
end)

local IsJumping=false
local BombIsLaid=false
local d=false
local Wait=0
local Denominator--[[ Lower=Easier ]] = 60

local rand=math.random

local function findNum(Item)
	if (Item>0 and Item<=(1/Denominator)) then
		return rand(125,150)
	elseif (Item>(1/Denominator)) and (Item<=(2/Denominator)) then
		return rand(87.5,112.5)
	elseif (Item>(2/Denominator)) and (Item<=(3/Denominator)) then
		return rand(50,75)
	else
		return 0
	end
end

function BombJump(Character,Time)	
	local random=findNum(Time)
	Character.PrimaryPart.Velocity=Vector3.new(	Character.PrimaryPart.Velocity.X,
												Character.PrimaryPart.Velocity.Y + random,
												Character.PrimaryPart.Velocity.Z)
end

local Cam=workspace.CurrentCamera

Tool.Activated:connect(function()
	if Tool.Enabled==false then return end
	c=Player.Character
	if not c then return end
	local h=Player.Character.Humanoid
	if not h then return end
	if h.Health<=0 then return end
	-- toggling of tool.enabled is handled in server script
	if IsJumping==true then -- Artificial Bomb-Jump If JumpThenClick
		BombJump(c,Wait)
	end
	
	Tool.Fire:FireServer(((Cam.CFrame-Cam.CFrame.p) + c.Head.Position):toWorldSpace(CFrame.new(0,4,-2)))
	
	BombIsLaid=true
	while BombIsLaid do
		Wait=Wait+(1/Denominator)
		wait(1/Denominator)
		if Wait>(3/Denominator) then
			BombIsLaid=false
		end
	end
	Tool.ResetTime:Fire()
end)

Tool.ResetTime.Event:connect(function()
	wait(3/Denominator)
	Wait=0
end)

local h
if c then
	h=c:FindFirstChild("Humanoid")
end

if not c then
	while wait() do
		c=Player.Character
		if c then
			break
		end
	end
end

if not h then
	h=c:FindFirstChild("Humanoid") -- if there was no character originally, we gotta ask for the humanoid again
end

if not h then
	while wait() do -- yield the rest of the code until we are sure a humanoid exists
		h=c:FindFirstChild("Humanoid")
		if h then
			break
		end
	end
end

h.Jumping:connect(function(J)
	if not J then return end
	if d==true then return end
	d=true
	
	if BombIsLaid==true then -- Artificial Bomb-Jump If ClickThenJump
		BombJump(c,Wait)
	end
	
	IsJumping=true
	
	while IsJumping do
		Wait=Wait+(1/Denominator)
		wait(1/Denominator)
		if Wait>(3/Denominator) then
			IsJumping=false
		end
	end
	
	Tool.ResetTime:Fire()
	
	d=false
end)]]></ProtectedString>
					<bool name="Disabled">false</bool>
