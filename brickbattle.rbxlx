		<Item class="Script" referent="RBXBE13B8926D514DA295A3A2E382A3DA1C">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Temporary fix for the issue where the towers are anchored for some reason. 
-- Looking back at some of this game's code is almost embarrassing. I've let stinky code sit around on my most popular game for a long time.
-- The sudden eruption of the issue has reignited the overhaul I was working on many months ago. Every script has been re-written, and all the tools are like in Crossroads and Chaos Canyon.
-- All that's left to do now is the shop. After that, a brief testing period will occur and then this game will finally be updated.

while true do
	local Anchored = 0
	for _,v in pairs(workspace.Doomspires:GetDescendants()) do
		if v:IsA("BasePart") and v.Anchored == true then
			Anchored = Anchored + 1
			v.Anchored = false
			v:MakeJoints()
		end
	end
	if Anchored > 0 then
		warn("!!! Unanchored",Anchored,"bricks !!!")
	end
	wait(30)
end]]></ProtectedString>
