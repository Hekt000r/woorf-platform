		<Item class="ModuleScript" referent="RBX34197740888C4CB68FB3CBE983137B87">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[local TrailModule = {}

local RainbowKeypoints = {	ColorSequenceKeypoint.new(0/7,Color3.new(255/255,000/255,000/255)),
							ColorSequenceKeypoint.new(1/7,Color3.new(255/255,170/255,000/255)),
							ColorSequenceKeypoint.new(2/7,Color3.new(255/255,255/255,000/255)),
							ColorSequenceKeypoint.new(3/7,Color3.new(000/255,255/255,000/255)),
							ColorSequenceKeypoint.new(4/7,Color3.new(000/255,000/255,255/255)),
							ColorSequenceKeypoint.new(5/7,Color3.new(125/255,000/255,185/255)),
							ColorSequenceKeypoint.new(6/7,Color3.new(200/255,080/255,255/255)),
							ColorSequenceKeypoint.new(7/7,Color3.new(255/255,000/255,255/255))}

local RisingSunKeypoints={	ColorSequenceKeypoint.new(0,Color3.new(255/255,255/255,000/255)),
							ColorSequenceKeypoint.new(1,Color3.new(255/255,000/255,000/255))}

local ArcticKeypoints={	ColorSequenceKeypoint.new(0,Color3.new(000/255,255/255,255/255)),
						ColorSequenceKeypoint.new(1,Color3.new(160/255,000/255,255/255))}
--[[
local FireKeypoints={	ColorSequenceKeypoint.new(0,Color3.new(000/255,127/255,000/255)), -- unused
						ColorSequenceKeypoint.new(0,Color3.new(255/255,127/255,000/255)),
						ColorSequenceKeypoint.new(0,Color3.new(255/255,255/255,150/255)),
						ColorSequenceKeypoint.new(0,Color3.new(255/255,255/255,255/255))}
]]
function TrailModule.AddTrail(Obj,AType,YVal,Lifetime,Transparency)
	local Trail=Instance.new("Trail")
	local A0=Instance.new("Attachment")
	local A1=Instance.new("Attachment")
	Trail.Parent=Obj
	Trail.FaceCamera=true
	if AType=="Rainbow" then
		Trail.Color=ColorSequence.new(RainbowKeypoints)
		Obj.BrickColor=BrickColor.new(1001)
	elseif AType=="RisingSun" then
		Trail.Color=ColorSequence.new(RisingSunKeypoints)
		Obj.BrickColor=BrickColor.new(1009)
		Obj.Material=Enum.Material.Neon
	elseif AType=="Arctic" then
		Trail.Color=ColorSequence.new(ArcticKeypoints)
		Obj.BrickColor=BrickColor.new(1019)
		Obj.Material=Enum.Material.Neon
	elseif AType=="TeamColor" then
		local TeamColor=Obj:WaitForChild("creator",1).Value.TeamColor
		Trail.Color=ColorSequence.new(TeamColor.Color)
		Obj.BrickColor=TeamColor
	--[[elseif AType=="Fire" then
		Trail.Color=ColorSequence.new(FireKeypoints)
		Obj.BrickColor=BrickColor.new(1011)]]
	end
	Trail.Lifetime=Lifetime
	Trail.Transparency=NumberSequence.new(0,Transparency)
	A0.Name="A0"
	A0.Position=Vector3.new(0,YVal,0)
	A1.Name="A1"
	A1.Position=Vector3.new(0,-YVal,0)
	A0.Parent=Obj
	A1.Parent=Obj
	Trail.Attachment0=A0
	Trail.Attachment1=A1
end

return TrailModule
]]></ProtectedString>
