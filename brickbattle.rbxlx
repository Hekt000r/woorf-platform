		<Item class="Script" referent="RBXE85FACA4F3AE482B94EE5070D5ADF09E">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local GP={
	["Rainbow"]=4422298,
	["RisingSun"]=4432678,
	["Arctic"]=4438755,
	["TeamColor"]=4438853,
	["Fire"]=4440015
}

--Add a new trail by inserting GP.nameofnewTrial = idNumberofnewTrial

local MPS=game:GetService("MarketplaceService") 

local Players={}
_G.UpdatePlayerTable=function(tbl) -- define _G stuff BEFORE retrieving services (like MarketplaceService, for example)
	for i,plr in pairs(tbl) do
		spawn(
			function()
				if not Players[plr] then
					local miniTbl={}
					for gpstr,gpid in pairs(GP) do
						local success, ownership = pcall(MPS.UserOwnsGamePassAsync, MPS, plr.UserId, gpid)
						if success then
							table.insert(miniTbl, {[gpstr]=gpid,["owns"]=ownership}) -- we dont really need the id variable but its better than a messy dictionary/array combo
						end
--						local ownership=MPS:UserOwnsGamePassAsync(plr.UserId,gpid)
--						table.insert(miniTbl,{[gpstr]=gpid,["owns"]=ownership}) -- we dont really need the id variable but its better than a messy dictionary/array combo
					end
					Players[plr]=miniTbl -- players[plr]
				end
			end
		)
	end
end

local function idIsValid(id)
	for i,v in pairs(GP) do
		if v==id then
			return true
		end
	end
	return false
end

local function getEffectFromId(id)
	for i,v in pairs(GP) do
		if v==id then
			return i
		end
	end
	return nil
end

local function findMyGPTable(player,gpstr)
	for plr,gp_array in pairs(Players) do
		if plr==player then
			for arrayval,gp_tbl in ipairs(gp_array) do
				for index,value in pairs(gp_tbl) do
					if index==gpstr then
						return gp_tbl
					end
				end
			end
		end
	end
	return nil
end

local function UpdateOwnershipStatus(gp_tbl,gpstr)
	if not gp_tbl then return nil end
	for i,v in pairs(gp_tbl) do
		if i==gpstr then
			gp_tbl["owns"]=true
		end
	end
end

game.ReplicatedStorage.Remotes.RequestPurchase.OnServerEvent:connect(function(player,aType)
	MPS:PromptGamePassPurchase(player,GP[aType])
end)

MPS.PromptGamePassPurchaseFinished:connect(function(player,id,wasPurchased)
	if not wasPurchased then return end
	if idIsValid(id)==false then return end
	local gpString=getEffectFromId(id)
	if not gpString then return end
	player.Effect.Value=gpString
	game.ReplicatedStorage.Remotes.GamepassOwnership:InvokeClient(player,player.Effect.Value,true)
	local gpTable=findMyGPTable(player,gpString)
	if not gpTable then return end
	UpdateOwnershipStatus(gpTable,gpString)
end)

game.ReplicatedStorage.Remotes.GamepassOwnership.OnServerInvoke = function(player,aType)
	if aType=="None" or aType=="TeamColor" or aType=="Fire" then
		player.Effect.Value=aType
		return true
	else
		if not GP[aType] then return false end
		--if MPS:UserOwnsGamePassAsync(player.UserId,GP[aType]) then
		local gptbl=findMyGPTable(player,aType)
		if not gptbl then return false end
		local ownership=gptbl["owns"]
		if ownership==true then
			player.Effect.Value=aType
		end
		return ownership
	end
end]]></ProtectedString>
