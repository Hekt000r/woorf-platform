			<Item class="Script" referent="RBX9743BF80FB1A426985BA97378AA48211">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Pellet = Instance.new("Part")
Pellet.Name="Pellet"
Pellet.Locked = true
Pellet.BackSurface = 0
Pellet.BottomSurface = 0
Pellet.FrontSurface = 0
Pellet.LeftSurface = 0
Pellet.RightSurface = 0
Pellet.TopSurface = 0
Pellet.Shape = 0
Pellet.Size = Vector3.new(1,1,1)
Pellet.BrickColor = BrickColor.new(2)

local Tool=script.Parent

Tool.PelletCreateEvent.OnServerEvent:connect(function(vPlayer,launch,vel)
	if Tool.Enabled==false then
		return
	end
	Tool.Enabled=false
	local missile = Pellet:clone()
	missile.Position=launch
	missile.Velocity=vel
	missile.Parent = game.Workspace
	missile:SetNetworkOwner(vPlayer)
	
	local creator_tag = Instance.new("ObjectValue")
	creator_tag.Value = vPlayer
	creator_tag.Name = "creator"
	creator_tag.Parent = missile
	
	local damage_value=Instance.new("IntValue")
	damage_value.Value=8
	damage_value.Name="damage"
	damage_value.Parent=missile
	
	local l=script:WaitForChild("SlingshotSound",1):Clone()
	l.Parent=Tool.Handle
	l:Play()
	l.Ended:connect(function()
		l:Destroy()
	end)
	wait(0.2)
	Tool.Enabled=true
end)]]></ProtectedString>
