		<Item class="ModuleScript" referent="RBX121C9A2465C44BF2BF57B0CB554EDFFF">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- written by GFink

local Debris=game:GetService("Debris")
local Rocket_Radius=4
local Rocket_BlastPressure=500000
local Bomb_Radius=12
local Bomb_BlastPressure=1000000

local Other = {}

function Other.Round(x)
	if x==nil then
		return 0
	end
	local y
	if x>0 then 
		y=math.floor(x)
	elseif x<0 then
		y=math.ceil(x)
	else
		return 0
	end
	local z=math.abs(x-y)
	if z>=0.5 then
		return math.ceil(x)
	else
		return math.floor(x)
	end
end
	
function Other.GetIndexFromValue(tbl,value)
	for i,v in pairs(tbl) do
		if v==value then 
			return i
		end
	end
end	

function Other.GetPlayerFromTool(tool)
	local m=tool:FindFirstAncestorWhichIsA("Model") or tool:FindFirstAncestorWhichIsA("Player")
	if m:IsA("Model") then
		local p=game.Players:GetPlayerFromCharacter(m)
		if p then
			return p
		else
			return "no player associated"
		end
	elseif m:IsA("Player") then
		return m
	else
		return "nothing at all"
	end
end
	
function Other.GetToolFromPlayer(toolname,player)
	local backpack=player:FindFirstChildWhichIsA("Backpack")
	if not backpack then
		return nil
	end
	local toolInPlayer=backpack:FindFirstChild(toolname,true) 
	if toolInPlayer then
		return toolInPlayer
	end
	local c=player.Character
	if not c then
		return nil
	end
	local heldTool=c:FindFirstChild(toolname,true) -- why would a tool being held ever be anything other than a child of character (as opposed to a descendant)?
	if heldTool then
		return heldTool
	end
	return nil
end

function ProtectTeam(creatorPlayer, ExpPos)
	local ff = {}
	for i,v in pairs(game.Players:GetChildren()) do
		if 	v.Character and 
			v.Character:FindFirstChild("HumanoidRootPart") and 
			v.TeamColor == creatorPlayer.TeamColor and 
			creatorPlayer.AntiTeamKill.Value==true and 
			creatorPlayer:DistanceFromCharacter(ExpPos)< 30 then
				
			local f = Instance.new("ForceField")
			f.Visible = false
			f.Parent = v.Character
			table.insert(ff, f)
			
		end
	end
	return ff
end

local SS=game:GetService("ServerStorage")
local EP=SS:WaitForChild("ExplosionParticles",5)

local at={
	["Rainbow"]=function()
		return {
			EP.RainbowA:Clone()
		}
	end,
	["RisingSun"]=function()
		return {
			EP.SungodA:Clone(),
			EP.SungodB:Clone(),
		}
	end,
	["Arctic"]=function()
		return {
			EP.BlizzariaA:Clone(),
			EP.BlizzariaB:Clone(),
		}
	end
}

function CreateParticleExplosion(AType,Explosion)
	if AType=="Rainbow" or AType=="RisingSun" or AType=="Arctic" then
		Explosion.Visible=false
		local PH--[[Particle Holder]]=Instance.new("Part")
		PH.CanCollide=false
		PH.Transparency=1
		PH.Anchored=true
		PH.Size=Vector3.new()
		PH.Position=Explosion.Position
		PH.Name="ParticleHolder"
		local PE=at[AType]()
		local PE1=PE[1]
		local PE2=PE[2]
		if PE1~=nil then
			PE1.Parent=PH
		end
		if PE2~=nil then
			PE2.Parent=PH
		end
		PH.Parent=workspace
		spawn(function() -- unyield the function as a whole
			local j=PH:GetChildren()
			local ef=0
			local da=#j
			for i=1,#j do
				if j[i]:IsA("ParticleEmitter") then
					spawn(function() -- both particleemitters affected asynchronously
						local T1=0
						local T2=100
						for s=0,20 do
							T1=T1+0.05
							T2=T2-5
							j[i].Transparency=NumberSequence.new(T1)
							j[i].Rate=T2
							wait(1/20)
						end
						ef=ef+1
					end)
				end
			end
			while wait(1/20) do
				if ef>=da then
					break
				end
			end
			Debris:AddItem(PH,0)
		end)
	end
end
		
function ApplyCreator(part,CreatorValue)
	local h=part.Parent:FindFirstChild("Humanoid")
	if h then
		local cnx
		cnx=h.Died:connect(function()
			if not h:FindFirstChild("creator") then
				local CVal=Instance.new("ObjectValue")
				CVal.Value=CreatorValue
				CVal.Name="creator"
				CVal.Parent=h
			end
		end)
		delay(.5,function() -- Unyield function
			cnx:Disconnect()
		end)
	end
end

local exceptions={"Excepted"}

function Exception(part)
	for i,v in pairs(exceptions) do
		if part.Name==v then
			return true
		end
	end
	return false
end

function UniversalExplode(CreatorValue,expType,Pos,Object)
	local dual=true
	local ff=ProtectTeam(CreatorValue,Pos)
	local explosion = Instance.new("Explosion")
	if expType=="Bomb" then -- no need for rocket situation because default explosion has rockets blastradius
		explosion.BlastRadius=Bomb_Radius
	elseif expType=="Rocket" then
		explosion.BlastRadius=Rocket_Radius
	end
	explosion.BlastPressure=0
	explosion.DestroyJointRadiusPercent=0
	explosion.Position=Pos
	explosion.Name="Explosion"
	explosion.Hit:connect(function(part,distance)
		if part:FindFirstAncestor("Doomspires") and part.BrickColor==CreatorValue.TeamColor then
			dual=false
		end
		if dual==false then
			if Exception(part) then
				part:BreakJoints()
			end
			local char=part:FindFirstAncestorWhichIsA("Model")
			if char then -- doesnt guarantee that its a char but its a good pre-req
				local h=char:FindFirstChildWhichIsA("Humanoid")
				if h then -- NOW we're ok
					local aplr=game.Players:GetPlayerFromCharacter(char)
					local ff2=char:FindFirstChildWhichIsA("ForceField")
					if (not ff2) and aplr.Team~=CreatorValue.Team then
						spawn(function()
							ApplyCreator(part,CreatorValue)
							char:BreakJoints() -- kill those not on creator's team
						end)
					end
				end
			end
		end
	end)
	
	if CreatorValue:FindFirstChild("Effect") then
		CreateParticleExplosion(CreatorValue.Effect.Value, explosion)
	end
	explosion.Parent = workspace
	
	wait() -- wait for all hitparts to be checked
	
	local exp2=explosion:Clone()
	exp2.Visible=false
	if expType=="Bomb" then -- dont need to specify blastradius because its cloning the old one with it specified
		exp2.BlastPressure=Bomb_BlastPressure
	elseif expType=="Rocket" then
		exp2.BlastPressure=Rocket_BlastPressure
	end
	if dual==true then
		exp2.DestroyJointRadiusPercent=1
	end
	exp2.Hit:connect(function(part,distance)
		ApplyCreator(part,CreatorValue)
	end)
	
	exp2.Parent=workspace
	delay(.5, function()
		for i,v in pairs(ff) do
			Debris:AddItem(v,0)
		end
	end)-- Untag humanoid
	
	if expType=="Bomb" then
		Object:ClearAllChildren()
		Debris:AddItem(Object,0)
	end
end

function Other.Explosion(CreatorValue,objName,pos,Object) -- 4th argument, Object, is optional and only used for the bomb (so far)
	if objName=="Bomb" then 
		--[[
			We handle the bomb's ticking in this module only because if it was handled in the tool script, there's a chance
			the player could leave or respawn, or in some other way have the script be disabled or deleted, causing the bomb
			to just sit there, stop ticking, and never go off.
		--]]
		local updateInterval = .4
		local currentMat = 1 
		local colors={"Really red","Really black"}
		local ticksound = Object.Click
		
		local function update()
			updateInterval = updateInterval * .9
			Object.BrickColor = BrickColor.new(colors[currentMat])
			currentMat = currentMat + 1
			if (currentMat > 2) then 
				currentMat = 1 
			end
		end
	
		while updateInterval > .1 do
			wait(updateInterval)
			update()	
			local l=ticksound:Clone()
			l.Parent=Object
			l:Play()
		end
		UniversalExplode(CreatorValue,objName,Object.Position,Object)
	elseif objName=="Rocket" then
		UniversalExplode(CreatorValue,objName,pos)
	end
end

return Other
]]></ProtectedString>
				<string name="ScriptGuid">{2D199663-F92E-4B4E-8CA1-302550B3F44E}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Other</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">08285c0aafb9c5f3020cf3450001a0f7</UniqueId>
			</Properties>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX04F833118D8D4706A9883EF6D453EB0A">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<BinaryString name="SerializedOverrides"></BinaryString>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">08285c0aafb9c5f3020cf34500019e64</UniqueId>
		</Properties>
		<Item class="Script" referent="RBX1C72862B897A4D7581012B200E306F60">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[ 
	
	Written by GFink. Except for the team balancing.
	This script can be placed anywhere.
	
	Cool features of this script:
	-- The Doomspires model can be a model, a folder, or any other class. It can also be placed ANYWHERE in workspace, including inside other objects.
	-- You can add new teams without knowing how to script! Just make sure you change the TeamColor of the new team's spawn.
	-- You can remove teams, too! 
	-- You can use pretty much any class to store the Doomspire towers/teams.
	---- Don't use Scripts to store them. 
	---- Don't place them inside the Misc or the GameValues folder.	
	
	-- However, when adding teams, make sure the tower itself is inside "Doomspires."
	-- Do not move the values inside each script to another location.
	-- Make sure the Holder part is always a child of the Doomspires class. 

]]	

PlayersRequiredToStartAwardingPoints=4

local y=workspace:GetDescendants()

for s=1,#y do
	if y[s].Name=="Doomspires" then
		
		-- GAME VALUES --
		local GVF=Instance.new("Folder")
		GVF.Parent=y[s]
		GVF.Name="GameValues"
		local TF=Instance.new("Folder")
		TF.Parent=GVF
		TF.Name="Teams"
		local TeamsLeftInt=Instance.new("IntValue")
		TeamsLeftInt.Parent=GVF
		TeamsLeftInt.Name="TeamsLeft"
		local k=y[s]:GetChildren()
		for o=1,#k do
			if not k[o]:IsA("Script") then -- Only make values 
				if k[o].Name~="GameValues" then
					if k[o].Name~="Holder" then
					
						local BCV=Instance.new("BrickColorValue")
						BCV.Parent=TF
						BCV.Name=k[o].Name
						
						local SpawnVal=Instance.new("IntValue")
						SpawnVal.Parent=BCV
						SpawnVal.Name="Spawns"
						
						local u=k[o]:GetDescendants()
						for h=1,#u do
							if u[h]:IsA("SpawnLocation") then
								BCV.Value=u[h].TeamColor
								SpawnVal.Value=#u[h].Parent:GetChildren()
							end
						end
						
					end
				end
			end
		end
		TeamsLeftInt.Value=#TF:GetChildren()
		
		-- GAME CONTROL --
		local x=y[s]:GetDescendants()
		for i=1,#x do
			if x[i]:IsA("SpawnLocation") then
				x[i].AncestryChanged:connect(function(SpawnPart) -- Technically this just checks for changes in parentage, but it also works when the spawn falls into the void. 
					local c=y[s]:WaitForChild("GameValues",1):WaitForChild("Teams",1):GetChildren() -- values are being created inscript, using WaitForChild to avoid syntax errors 
					for g=1,#c do -- Begin scanning in order to associate the GameValues with the actual game
						
						if SpawnPart:IsA("SpawnLocation") then
							if c[g].Value==SpawnPart.TeamColor then -- If one of the BrickColorValues in GameValues.Teams is equal to the SpawnLocation's TeamColor (NOT the spawn's BrickColor), then ...
								
								c[g]:WaitForChild("Spawns",1).Value=c[g]:WaitForChild("Spawns",1).Value-1 -- ... subtract that team's spawn value in GameValues.Teams.[TeamName]. Remember, this is if one of the spawns is deleted.
								
								if c[g]:WaitForChild("Spawns",1).Value==0 then -- If you have no spawns left, then you lose.
									
									y[s]:WaitForChild("GameValues",1):WaitForChild("TeamsLeft",1).Value=y[s]:WaitForChild("GameValues",1):WaitForChild("TeamsLeft",1).Value-1 -- This is vital to the game ending as a whole.
									
									game.Teams:FindFirstChild(c[g].Name).AutoAssignable=false
									local msg=Instance.new("Message")
									msg.Text=c[g].Name.." TEAM has been eliminated!"
									msg.Parent=workspace
								end
							end
						end
						
						if y[s]:WaitForChild("GameValues",1):WaitForChild("TeamsLeft",1).Value==1 then -- If 1 team remains then...
							local e=y[s]:WaitForChild("GameValues",1):WaitForChild("Teams",1):GetDescendants()
							for j=1,#e do
								if e[j].Name=="Spawns" then
									if e[j].Value~=0 then -- ... find that team, whose spawn does NOT have a value of zero ...
											wait(4)
										local msg=Instance.new("Message")
										msg.Text=e[j].Parent.Name.." TEAM has won the game!" 
										local p=game.Players:GetChildren()
										for q=1,#p do
											if #p>=PlayersRequiredToStartAwardingPoints then -- if there's more than 4 people playing lmao
												if e[j].Parent and p[q].TeamColor==e[j].Parent.Value then
													pcall(function() game:GetService("PointsService"):AwardPoints(p[q].userId, 100) end)
												end
											end
										end
										msg.Parent=workspace
											
										script.RegenScriptLocation.Value.Signal.Value=true -- ... regen the map using the Changed function. 
										
										return
									end
								end
							end
						end	
					end
				end)
			end
		end
	end
end

-- All the stuff below until the while loop was probably not written by Hybridtheory00. That's the guy who was selling the free model where this came from but I doubt he made it.
-- Anyways, this is just great! :)

function AssignableTeams()
	local assignableTeams = {}
	for _, team in pairs(game.Teams:GetTeams()) do
		if team.AutoAssignable then
			table.insert(assignableTeams, team)
		end
	end
	return assignableTeams
end

script:WaitForChild("ShuffleTeams").OnInvoke = function()
	local teams = AssignableTeams()
	local numberOfTeams = #teams
	local playersList = game.Players:GetPlayers()
	local numberOfPlayers = #playersList

	-- Quit early if there are no teams, this avoids a divide by zero
	if #teams == 0 or #playersList == 0 then
		return
	end

	local playersPerTeam = math.floor(numberOfPlayers / numberOfTeams)
	local leftOverPlayers = numberOfPlayers - (playersPerTeam * numberOfTeams)
	local teamCount = {}

	for _, team in ipairs(teams) do
		teamCount[team] = 0
		for i = 1, playersPerTeam do
			local k = math.random(1, #playersList)
			local player = playersList[k]
			if player then
				player.TeamColor = team.TeamColor
				teamCount[team] = teamCount[team] + 1
				table.remove(playersList, k)
			end
		end
	end

	-- Now place the remaining players
	for i = 1, leftOverPlayers do
		local k, player = next(playersList)
		local teamIndex = math.random(1, #teams)
		local team = teams[teamIndex]
		if player and teamIndex then
			player.TeamColor = team.TeamColor
			table.remove(playersList, k)
			table.remove(teams, teamIndex)
		end
	end
end

script:WaitForChild("BalanceTeams").OnInvoke = function()
	local playersList = game.Players:GetPlayers()
	local teams = AssignableTeams()
	local teamCounts = {}

	-- Quit early if there are no teams
	if #teams == 0 or #playersList == 0 then
		return
	end

	for _, team in pairs(teams) do
		teamCounts[team] = 0
		for _, player in pairs(playersList) do
			if player.TeamColor == team.TeamColor then
				teamCounts[team] = teamCounts[team] + 1
			end
		end
	end

	while true do
		local smallestTeam = next(teamCounts)
		local largestTeam = smallestTeam
		-- Find the smallest and largest teams
		for team, count in pairs(teamCounts) do
			if count < teamCounts[smallestTeam] then
				smallestTeam = team
			end
			if count > teamCounts[largestTeam] then
				largestTeam = team
			end
		end
		-- If the teams are unbalanced/uneven
		if (teamCounts[largestTeam] - teamCounts[smallestTeam]) > 1 then
			-- Give a player from the largest team to the smallest
			for _, player in pairs(playersList) do
				if player.TeamColor == largestTeam.TeamColor then
					player.TeamColor = smallestTeam.TeamColor
					teamCounts[smallestTeam] = teamCounts[smallestTeam] + 1
					teamCounts[largestTeam] = teamCounts[largestTeam] - 1
					break
				end
			end
		else -- Teams are balanced as well as they can be
			return
		end
	end
end

while wait(10) do --[[ Check if a spawn is flung a billion studs away and doesn't despawn, 
						thereby putting the game at a stalemate. This happens to me (gfink)
						about one in every 5 games or so.]]
	local p=game.Players:GetPlayers()
	if workspace:FindFirstChild("Baseplate") then
		local baseplate=workspace.Baseplate
		x=workspace.Doomspires:GetDescendants()
		local spawns=0
		for i=1,#x do
			if x[i]:IsA("SpawnLocation") then
				if (x[i].Position-baseplate.Position).magnitude>500 then -- If a spawn is >500 studs from the baseplate then, 
					x[i]:Destroy() -- delete it.
				else
					spawns=spawns+1
				end
			end
		end
		if spawns<=0 then 
			warn("Game might have broke, regenerating")
			script.RegenScriptLocation.Value.Signal.Value=true
		end
	else
		for i=1,#p do
			p[i]:Kick("Possible exploit, shutting down server")
		end
	end
end]]></ProtectedString>
