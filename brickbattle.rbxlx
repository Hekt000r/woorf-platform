			<Item class="LocalScript" referent="RBX28104739195D4F96A8E1292D838A7B63">
				<Properties>
					<ProtectedString name="Source"><![CDATA[while wait() do
	if game:IsLoaded()==true then
		break
	end
end

local wfc=3

local GUI=script.Parent
local Frame=GUI:WaitForChild("InstructionsFrame",wfc)
local Button=Frame:WaitForChild("PlayButton",wfc)
local Text=Frame:WaitForChild("HowToPlay",wfc)

Button.Activated:connect(function()
	Button.Visible=false
	local ft=0.5
	local tt=0
	for i=0.5,1,0.0125 do
		ft=ft+0.0125
		tt=tt+0.025
		Frame.BackgroundTransparency=ft
		Text.TextTransparency=tt
		wait()
	end
	GUI:Destroy()
end)]]></ProtectedString>
					<bool name="Disabled">false</bool>
