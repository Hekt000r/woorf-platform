				<Item class="LocalScript" referent="RBX06D999F792514F01B3050AF47466209C">
					<Properties>
						<ProtectedString name="Source"><![CDATA[while wait() do
	if game:IsLoaded()==true then
		break
	end
end

local wfc=3

local Frame=script.Parent
local GUI=Frame.Parent
local RSP=game:GetService("ReplicatedStorage")
local ColorFolder=GUI:WaitForChild("Folder",wfc)

local x=Frame:GetDescendants()

for i=1,#x do
	if x[i]:IsA("ImageButton") or x[i]:IsA("TextButton") then
		if x[i]:IsA("TextButton") then
			local Color3Val=Instance.new("Color3Value")
			Color3Val.Name=x[i].Name.."Text"
			Color3Val.Parent=ColorFolder
			Color3Val.Value=x[i].TextColor3
			local Color3Val2=Instance.new("Color3Value")
			Color3Val2.Name=x[i].Name.."Background"
			Color3Val2.Parent=ColorFolder
			Color3Val2.Value=x[i].BackgroundColor3
		end
		x[i].Activated:connect(function()
			ToggleEffect(x[i].Name,false) --[[ 	The name of the button should be the
											name of the string in PurchaseControl
											script ]]
		end)
	end
end

function ToggleEffect(aType,bypassPassRequest)
	local bpr2=bypassPassRequest
	if bpr2==false then
		bpr2=RSP.Remotes.GamepassOwnership:InvokeServer(aType) -- this will either be true or false
	end
	if bpr2==true then -- this variable acts as a bypass or an actual request result
		for i=1,#x do
			if x[i]:IsA("TextButton") then
				x[i].TextColor3=ColorFolder:WaitForChild(x[i].Name.."Text").Value
				x[i].BackgroundColor3=ColorFolder:WaitForChild(x[i].Name.."Background").Value
			end
		end
		for i=1,#x do
			if x[i]:IsA("TextButton") then
				if x[i].Name==aType then
					x[i].TextColor3=Color3.new(1-x[i].TextColor3.r,1-x[i].TextColor3.g,1-x[i].TextColor3.b)
					x[i].BackgroundColor3=Color3.new(1-x[i].BackgroundColor3.r,1-x[i].BackgroundColor3.g,1-x[i].BackgroundColor3.b)
				end
			end
		end
	elseif bpr2==false then
		RSP.Remotes.RequestPurchase:FireServer(aType)
	end
	return true
end
	
RSP.Remotes.GamepassOwnership.OnClientInvoke=ToggleEffect]]></ProtectedString>
