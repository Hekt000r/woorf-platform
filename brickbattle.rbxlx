				<Item class="LocalScript" referent="RBX9437FA4DB0464FD6888AF3E05D46D3D2">
					<Properties>
						<ProtectedString name="Source"><![CDATA[while wait() do
	if game:IsLoaded()==true then
		break
	end
end

local wfc=5

local Frame=script.Parent
local GUI=Frame.Parent
local Images=Frame:WaitForChild("Images",wfc)
local Labels=Frame:WaitForChild("Labels",wfc)
local ClearButton=Frame:WaitForChild("ClearButton",wfc)
local BackButton=Frame:WaitForChild("BackButton",wfc)
local BackButton2=BackButton:WaitForChild("BackButton",wfc)
local SettingsFrame=GUI:WaitForChild("SettingsFrame",wfc)

local coolDown = 0
local tools = {}
local totalNumTools=#game.StarterPack:GetChildren()

for i,v in pairs(Images:GetChildren()) do
	if v:IsA("GuiButton") then
		v.Activated:connect(function()
			local found = false
			for i,z in pairs(tools) do
				if v.Name == z then
					found = true
				end
			end
			
			if found==false and #tools < totalNumTools then
				table.insert(tools, v.Name)
				Labels[v.Name].Text = #tools
			end
		end)
	end
end

local function resetWIPOrder()
	tools = {}
	for i,v in pairs(Labels:GetChildren()) do
		if v:IsA("TextLabel") then
			v.Text=""
		end
	end
end

ClearButton.Activated:connect(function()
	resetWIPOrder()
end)

local hovercolor=BrickColor.new(23).Color
local defaultcolor=BrickColor.new(1001).Color

BackButton2.MouseEnter:connect(function()
	BackButton2.ImageColor3=hovercolor
end)

BackButton2.MouseLeave:connect(function()
	BackButton2.ImageColor3=defaultcolor
end)

BackButton.Activated:connect(function()
	SettingsFrame.Visible=true
	Frame.Visible=false
end)

local backingout=false

BackButton2.Activated:connect(function()
	if backingout==true then return end
	backingout=true
	BackButton2.ImageColor3=defaultcolor
	SettingsFrame.Visible=true
	Frame.Visible=false
	backingout=false
end)

local function countText(str,tm)
	Frame.UpdateButton.Text=str.." (".. tostring(tm)..")"
	for i=tm,1,-1 do
		Frame.UpdateButton.Text=str.." (".. tostring(i)..")"
		wait(1)
	end
end

local updating=false
Frame.UpdateButton.Activated:connect(function()
	if updating==true then return end
	updating=true
	if #tools==totalNumTools then
		game.ReplicatedStorage.Remotes.Backpack:FireServer(tools)
		resetWIPOrder()
		countText("Updating",7)
	elseif #tools<totalNumTools then
		countText("Please select an order.",3)
	else
		countText("???",3)
	end
	Frame.UpdateButton.Text = "Update"
	updating=false
end)
]]></ProtectedString>
